{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexusbyte-backend",
  "main": "worker.js",
  "compatibility_date": "2026-11-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexusbyte-db",
      "database_id": "13e08eb2-6c0c-4e69-9aa8-e55c8ae0465a"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nexusbyte.de5.net",
    "B2_BUCKET_NAME": "StorStorage",
    "B2_ENDPOINT": "s3.us-east-005.backblazeb2.com",
    "B2_KEY_ID": "005ad09ec7d70a00000000001",
    "B2_REGION": "us-east-005"
  }
  // Required Cloudflare Worker secrets (configure via `wrangler secret put <NAME>`):
  // - NOWPAYMENTS_API_KEY
  // - NOWPAYMENTS_IPN_SECRET
  // - NOWPAYMENTS_EMAIL
  // - NOWPAYMENTS_PASSWORD
  // - NOWPAYMENTS_TOTP_SECRET
  // - B2_APP_KEY
  // - JWT_SECRET
  // - RESEND_API_KEY
  // - EMAIL_FROM (e.g. "NexusByte <noreply@nexusbyte.de5.net>")
}
